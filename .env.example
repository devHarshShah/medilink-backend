# Copy to .env for local (non-Docker) runs. docker-compose.yml sets these itself.

DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://medilink:medilink@localhost:5432/medilink

# Auth - generate a real one for anything non-local:  openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: the Next.js origin. Credentials are off (the frontend uses bearer tokens).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Redis - backs SSE pub/sub for live queue updates
REDIS_URL=redis://localhost:6379/0

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=medilink
S3_SECRET_KEY=medilink123
S3_BUCKET=medilink-documents

# AI triage. Without a key the rule-based fallback provider is used, so the
# queue keeps working - responses come back with fallback_used: true.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-sonnet-5
